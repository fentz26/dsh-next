// TEMP NOTES: 'exclude' below contains packages/checkpoints pending a parallel
// workstream finishing its typecheck; drop those entries once it lands.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "benches/src/**/*.ts",
    "crates/native-journal/__test__/**/*.ts",
    "crates/native-journal/__test__/**/*.ts"
  ],
  "exclude": [
    "packages/checkpoints/src/**/*.ts",
    "packages/checkpoints/tests/**/*.ts"
  ]
}
